# Data and third-party assets, linked in by scripts/fetch_third_party.py
inputs/
third_party/

# Experiment artefacts: every one is regenerable from the code and the configs
results/
runs/
slurm_driver_logs/

# LaTeX build products; the sources and the figure data are tracked
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.pdf
paper/llncs.cls
paper/splncs04.bst
paper/generated/figures/**/*.pdf
paper/generated/figures/**/*.png
paper/generated/figures/**/*.jpg
paper/generated/figures/**/*.placeholder
# Rendered qualitative panels are patient photographs and are regenerable with
# `make figures`; only the numeric source data behind each figure is tracked.
paper/generated/figures/five_views/

# Viewer
app/frontend/node_modules/
app/frontend/dist/
app/backend/outputs/

# Session scratch
prompt.md
wget-log*
.claude/
